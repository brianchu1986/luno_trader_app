# =========================
# LUNO API CREDENTIALS
# =========================
LUNO_ADMIN_KEY=
LUNO_ADMIN_SECRET=
LUNO_API_KEY=
LUNO_API_SECRET=

# =========================
# APP SETTINGS
# =========================
LOG_LEVEL=DEBUG # Options: DEBUG, INFO, WARNING
LOG_DIR=logs
RUN_MODE=dry_run    # Options: dry_run, live
RUN_EVERY_N_MINUTES=10
USE_MANY_MODELS=False
TRADER_TIMEOUT_SECONDS=300
TRADER_MAX_TURNS=30

# =========================
# RISK GUARD
# =========================
RISK_MAX_TRADE_PCT=0.25 # Max BUY size as % of available MYR balance (0 disables)
RISK_MAX_POSITION_PCT=0.5 # Max single-asset exposure as % of portfolio value (0 disables)
RISK_MIN_MYR_BALANCE=0 # Minimum MYR cash to keep after BUYs (0 disables)
RISK_MAX_NOTIONAL_MYR=0 # Max notional MYR per trade (0 disables)
RISK_MAX_BUYS_24H=0 # Max BUY trades in the last 24h (0 disables)
RISK_TRADE_COOLDOWN_MINUTES=0 # Cooldown per market+side before next trade (0 disables)

# =========================
# TOOLS API CREDENTIALS
# =========================
BRAVE_SEARCH_API=
BRAVE_REQUESTS_PER_SECOND=1
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
